#!/usr/bin/env python3
"""PreToolUse hook on Bash: a board post that answers from the web must cite the pages it used.

If the agent read outside web pages (WebFetch, WebSearch, or curl/wget to a non-local http(s) URL) since its last post,
and the post it is about to send has no footnote (`[^`; a plain link is not enough), the post is refused once with a note saying
how to cite. The same post sent again goes through, so this can never block an agent for good (a post that rightly
has nothing to cite just repeats). Anything it can't read lets the call through."""
import hashlib, json, os, re, sys
from pathlib import Path

POST = re.compile(r"\b(hive|hive)\s+post\b")
WEB = re.compile(r"\b(curl|wget)\b[^|;&]*?https?://(?!(localhost|127\.[\d.]+|\[::1\]|0\.0\.0\.0)(?![\w.-]))", re.S)


# E47: a counted answer built on web reads must quote a page that states the count, or finish the tally with code.
HEDGE = re.compile(r"\b(on my count|by my count|my (own )?(count|tally)|my rough count|a tie on my)\b|\b(about|roughly|around|approximately|nearly)\s+\d[\d,]*\s+(\w+\s+)?(each|laureates?|prizes?|winners?|people|countries|times|medals?|wins?|titles?)\b", re.I)

# E49: a tutor reply must not call a wrong attempt "close" when the number is far off.
CLOSE = re.compile(r"\b(you['\u2019]?re|you are|that['\u2019]?s|it['\u2019]?s) (very |pretty |so |quite |really )?(close|almost there|nearly there|not far off)\b|\b(close|so close),? but\b|\bnot quite,? but\b", re.I)

# E50: a routine process note ("didn't watch it play", "from memory, didn't open pages") reads as the agent's note to itself.
SELFAUDIT = re.compile(r"\b(did not|didn['\u2019]?t|have not|haven['\u2019]?t|never) (watch(ed)?|see|seen|click(ed)?|open(ed)?) (it|the (chart|animation|page|pages)) ?(play|run|drawn|being drawn|render(ed)?)?\b|\bfrom memory, (did not|didn['\u2019]?t) open\b|\bI did not watch it\b", re.I)


def web_reads(transcript):
    """Tool uses since the agent's last post that read the outside web."""
    reads = []
    for line in Path(transcript).read_text(errors="replace").splitlines():
        try: m = json.loads(line)
        except ValueError: continue
        if m.get("type") != "assistant": continue
        for b in (m.get("message") or {}).get("content") or []:
            if not isinstance(b, dict) or b.get("type") != "tool_use": continue
            name, inp = b.get("name"), b.get("input") or {}
            if name == "Bash" and POST.search(inp.get("command") or ""): reads = []
            elif name in ("WebFetch", "WebSearch") or (name == "Bash" and WEB.search(inp.get("command") or "")): reads.append(name)
    return reads


def main():
    try:
        d = json.load(sys.stdin)
        if d.get("tool_name") != "Bash": return 0
        cmd = (d.get("tool_input") or {}).get("command") or ""
        if not POST.search(cmd) or "--done-quiet" in cmd: return 0
        if SELFAUDIT.search(cmd):
            r = once(cmd + "#audit", "This post ends with a note about how you checked (\"didn't watch it play\", \"didn't open the pages\"). The reader takes it as your note to yourself. "
                     "Drop it. If something specific could be broken and the person needs to know (a button you could not press, a number you could not look up), say that in one plain clause aimed at them, "
                     "e.g. \"I haven't tried the Pause button; tell me if it doesn't work.\" If it truly matters, send the same post again and it goes through.")
            if r: return r
        if CLOSE.search(cmd):
            r = once(cmd + "#close", "This post tells someone their answer is \"close\" or \"almost there\". Work out the gap first: only say close if their number is within about 1% of the right one. "
                     "If it is further off, say plainly that it is not right, name the mistake, and let them see the correct steps (the year-by-year numbers) before or instead of any praise. "
                     "If it really is close, send the same post again and it goes through.")
            if r: return r
        if HEDGE.search(cmd) and web_reads(d["transcript_path"]):
            return once(cmd + "#count", "This post gives a count as \"about N\" or \"on my count\". For a counting question, quote a page that states each number "
                        "(cite it with a footnote) or finish the tally with code, then give exact numbers, say what was counted and as of which year, and make the numbers agree with each other. "
                        "If the number truly is approximate at the source, send the same post again and it goes through.")
        if "[^" in cmd: return 0  # a footnote; a bare or inline link alone draws no Sources list
        if not web_reads(d["transcript_path"]): return 0
    except Exception:
        return 0
    return once(cmd, "This post has no sources, but you read web pages for it. Cite each fact from a page with a footnote: "
                "`...fact.[^1]` in the text and `[^1]: [Page title](https://...)` at the end, one link per note, for the pages you "
                "actually opened. If nothing in it came from the web, send the same post again and it goes through.")


def once(cmd, note):
    """Refuse this exact post once (exit 2 with the note); the same post again goes through."""
    seen = Path(os.environ.get("TMPDIR") or "/tmp") / "cc-cite-hook"
    key = hashlib.sha256(cmd.encode()).hexdigest()[:16]
    try:
        seen.mkdir(parents=True, exist_ok=True)
        if (seen / key).exists(): return 0
        (seen / key).touch()
    except OSError:
        return 0
    print(note, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
