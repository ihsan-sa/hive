def cmd_help(a):
    """hive help [TOPIC]: the parts of the orientation an agent needs only now and then, from core/help/TOPIC.md."""
    d = CORE / "help"
    topics = sorted(f.stem for f in d.glob("*.md"))
    if not a.topic:
        for t in topics: print(f"  {t:8} {(d / (t + '.md')).read_text().split(chr(10), 1)[0].split(':', 1)[-1].strip()}")
        print("hive help TOPIC prints one; hive COMMAND --help shows a command's flags"); return
    t = a.topic.lower()
    hits = [x for x in topics if x.startswith(t)]
    if len(hits) != 1: sys.exit(f"hive help: no single topic {a.topic!r}; topics: {', '.join(topics)}")
    print((d / (hits[0] + ".md")).read_text().split("\n", 1)[1].strip())
