        fcntl.flock(f, fcntl.LOCK_EX); f.write(json.dumps({"thread": th, "from": os.environ.get("HIVE_NAME", "anon"), "title": title, "at": time.time()}) + "\n")
    print(f"renamed {th}: {title}")

