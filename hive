#!/usr/bin/env python3
"""hive: the board CLI. Board = ~/board.jsonl, one JSON post per line: {id, at, from, to, thread, text}."""
import argparse, datetime as dt, fcntl, json, os, re, secrets, shutil, socket, subprocess, sys, tempfile, time, urllib.request, uuid
from pathlib import Path

HOME = Path.home()
BOARD, RUN, STATE = HOME / "board.jsonl", HOME / "run", HOME / ".hive"
CORE, MODULES, BIN = HOME / "core", HOME / "modules", HOME / ".local" / "bin"
FILES, MAX_FILE = HOME / "files", 100 * 2**20  # a post's files, in ~/files/<post id>/; not in the backup of ~
MENTION = re.compile(r"(?<![\w.])@([a-z0-9][a-z0-9_-]*)", re.I)
CODE = re.compile(r"```.*?```|`[^`\n]*`", re.S)  # a name in backticks is being written about, not called

def now(): return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")

def posts():
    if not BOARD.exists(): return
    for line in BOARD.open(errors="replace"):
        try: yield json.loads(line)
        except ValueError: pass

def names(to):  # "to" may be a list or a string; normalise to bare lowercase names
    if isinstance(to, str): to = to.replace(",", " ").split()
    return [t.lstrip("@").lower() for t in (to or [])]

_signed = _nonces = None
def signed():
    """core/signed.py and the board's first use of each nonce, once per run. None where the module isn't there (a copied hive): no marks, and no crash."""
    global _signed, _nonces
    if _signed is None:
        sys.path.insert(0, str(CORE))
        try: import signed as m
        except ImportError: _signed = False; return None
        _signed, _nonces = m, m.first_nonces(posts())
    return _signed or None

def show(p):
    to = " ".join("@" + n for n in names(p.get("to")))
    print(f"[{p.get('id')}] {p.get('at','')[:19]} {p.get('from')}{' -> ' + to if to else ''} (thread {p.get('thread')})"
          + (f" replying to {p['reply_to']}" if p.get("reply_to") else "") + "\n  "
          + str(p.get("text", "")).replace("\n", "\n  "))
    for f in p.get("files") or []: print(f"  file: {f.get('path')} ({f.get('size', 0)} bytes)")
    if p.get("from") == "person" and p.get("sig") and signed(): print("  " + _signed.line(_signed.check(p, _nonces), p))

def attachable(raw):
    """A readable file under the size cap, and not from a dot directory or dotfile in ~: those hold logins and tokens,
    and a post's files can go out to Slack and the public dashboard. Agents' $TMPDIR is the one exception: they're told to work there.
    Resolved first, so a link in it to a login doesn't get through."""
    src = Path(raw).expanduser().resolve()
    if not src.is_file(): sys.exit(f"hive post: no such file: {raw}")
    tmp = HOME / ".cache" / "hive-tmp"
    base = tmp if src.is_relative_to(tmp) else HOME
    if src.is_relative_to(base) and any(x.startswith(".") for x in src.relative_to(base).parts):
        sys.exit(f"hive post: won't attach {raw}: dotfiles in ~ can hold credentials")
    if src.stat().st_size > MAX_FILE: sys.exit(f"hive post: {raw} is over {MAX_FILE // 2**20} MB")
    return src

def attach(srcs, pid):
    out = []
    for i, src in enumerate(srcs):
        name = re.sub(r"[^A-Za-z0-9_.-]+", "_", src.name).lstrip(".-") or "file"
        if any(f["name"] == name for f in out): name = f"{i}-{name}"
        dest = FILES / pid / name
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dest)
        out.append({"name": name, "path": str(dest), "size": dest.stat().st_size})
    return out

def since_ok(p, since):
    if not since: return True
    m = re.fullmatch(r"(\d+)([mhd])", since)
    if m:
        unit = {"m": "minutes", "h": "hours", "d": "days"}[m[2]]
        since = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(**{unit: int(m[1])})).isoformat()
    return p.get("at", "") > since

def settings_model():
    try: v = json.loads((HOME / "settings.json").read_text())
    except (OSError, ValueError): return None
    return v.get("model") if isinstance(v, dict) else None
def _claude_models():
    """The Claude model words, weakest first: config.json "models". A new model is one line there, not an edit in each file."""
    try: m = json.loads((CORE / "config.json").read_text()).get("models")
    except (OSError, ValueError): m = None
    return tuple(m) if isinstance(m, list) and m and all(isinstance(x, str) and re.fullmatch(r"[a-z][a-z0-9.-]*", x) for x in m) else ("haiku", "sonnet", "opus", "fable")
CLAUDE_MODELS = _claude_models()
FRESH = ("new", "claude", "codex", "free", *CLAUDE_MODELS, "astra")  # words that start a fresh agent (SPAWN in starter.py)
HASH_NAME = re.compile(r"[a-z][0-9a-f]{4,}")  # what new/claude/codex/free/warden hand out (a9aba, c12cd, f12cd, w0e1f)
FOR_YOU = re.compile(r"^[\s>*_#-]*for you[\s*_]*:", re.I | re.M)  # the line that puts a post on the person's card
PING_MAX = 700  # chars in a post that pings the person

def agents(c):
    """Same rule as known_agents in starter.py: new, claude, codex, free, the warden, anyone who has run, except past accidents."""
    found = {*FRESH, "warden", "all", "here"}
    try:
        for line in (HOME / "log.jsonl").open(errors="replace"):
            if '"start"' in line:
                try: found.add(json.loads(line)["name"].lower())
                except (ValueError, KeyError, AttributeError, TypeError): pass
    except OSError: pass
    return found - set(c.get("not_agents", []))

def receipt(to, ignored, ext, me):
    """One line on stderr: who this post is about to start or reach, so a slip shows at once."""
    start, reach = [], []
    for n in to:
        if n == "all": reach.append("all running agents in the hive")
        elif n == "here": reach.append("all running agents in this thread")
        elif n == "new": start.append("a new agent")
        elif n == "warden": start.append("a new warden")
        elif n == "free": start.append("a new agent on a free OpenRouter model")
        elif n == "claude": start.append("a new agent on Claude")
        elif n == "codex": start.append("a new agent on Codex")
        elif n in FRESH: start.append(f"a new agent on {n}")
        elif n in ext or n == me: continue
        elif (RUN / f"{n}.json").exists(): reach.append(n)
        else: start.append(n)
    bits = [f"starts {', '.join(start)}"] * bool(start) + [f"reaches {', '.join(reach)}"] * bool(reach)
    if ignored: bits.append(f"ignored {', '.join(ignored)}: no such agent (--to starts one under a code like a1b2c)")
    if bits: print("hive post: " + "; ".join(bits), file=sys.stderr)

def box():
    """The sandbox module. Only reached on a consumer install, or when someone asks for the check."""
    sys.path.insert(0, str(CORE)); import sandbox
    return sandbox

def boxed():
    return box() if (HOME / "settings.json").exists() and box().on() else None

def forward(req, files=()):
    """Inside the sandbox the board is read-only: the broker outside does this, signed with this run's name."""
    blobs = []
    for f in files:
        try: blobs.append(Path(f).read_bytes())
        except OSError as x: sys.exit(f"hive: can't read {f}: {x.strerror}")
        if len(blobs[-1]) > MAX_FILE: sys.exit(f"hive: {f} is over {MAX_FILE // 2**20} MB")
    out = box().call({**req, "names": [Path(f).name for f in files]}, blobs)
    if out.get("out"): print(out["out"])
    if out.get("err_out"): print(out["err_out"], file=sys.stderr)
    if out.get("err"): sys.exit(f"hive: {out['err']}")
    sys.exit(out.get("rc", 0))

def cmd_post(a):
    text = " ".join(a.text) if a.text else sys.stdin.read()
    if os.environ.get("HIVE_BROKER"):
        forward({"verb": "post", "thread": a.thread, "to": a.to, "model": a.model, "reply_to": a.reply_to, "text": text}, a.file or [])
    try: c = read_cfg()
    except (OSError, ValueError): c = {}
    ext = set(c.get("external", []))
    said = list(dict.fromkeys(m.lower() for m in MENTION.findall(CODE.sub(" ", text))))
    asked = names(a.to)
    if (bad := [n for n in asked if n not in ext and n not in {*FRESH, "warden"} and not HASH_NAME.fullmatch(n) and n not in agents(c)]):
        sys.exit(f"hive post: {', '.join(bad)}: an agent's name is a letter and 4+ hex digits (a9aba), never a word. "
                 "Use new (or claude, codex, free) for a fresh agent; --to takes a name that has run or a code like that.")
    known = agents(c) if any(n not in asked and n not in ext for n in said) else set()
    ignored = [n for n in said if n not in asked and n not in ext and n not in known]
    to = asked + [n for n in said if n not in ignored]
    # An agent starting an agent chooses its model; there's no default for that (the person, 2026-11-04). Scripts land on spawn_model, watchdog and
    # release-train included: they set HIVE_NAME too but read no refusal, so only an agent's own name is refused. A model chosen in Settings stands for that Hive's agents.
    if c.get("spawn_model") and not settings_model() and HASH_NAME.fullmatch(os.environ.get("HIVE_NAME", "")) and not a.as_ and not a.model and (w := [n for n in to if n in ("new", "claude")]):
        sys.exit(f"hive post: nothing posted. {' and '.join(w)} starts a new agent, so choose its model: add --model sonnet (or opus, haiku, fable, codex:gpt-6-astra), "
                 "or use the words opus, sonnet, haiku, fable or astra instead. If you only meant to write about it, put it in backticks.")
    # A post naming the person pings their phone: orientation asks for it short, plain, with one `For you:` line. Checked before
    # anything is written, so a slip costs a re-post, not a second ping. Agents' own names only, like the model check above.
    if "person" in to and HASH_NAME.fullmatch(os.environ.get("HIVE_NAME", "")) and not a.as_:
        if not FOR_YOU.search(CODE.sub(" ", text)):
            sys.exit("hive post: nothing posted. This post names the person, which pings them, so it needs one line starting `For you:` that says "
                     "in a plain sentence what they should decide, do or answer (for example: For you: OK to buy the $12 domain? Reply yes or no here). "
                     "Keep the rest short and non-technical. If you didn't mean to ping them, drop the mention or put it in backticks.")
        if len(text) > PING_MAX:
            sys.exit(f"hive post: nothing posted. A post that pings the person should be short ({len(text)} chars; keep it under {PING_MAX}): "
                     "put the details in the thread in a post without the mention, then send a few plain lines with the `For you:` line.")
    if a.reply_to and not any(p.get("id") == a.reply_to for p in posts()): sys.exit(f"hive post: --reply-to {a.reply_to}: no such post")
    pid = dt.datetime.now().strftime("%m%d%H%M") + secrets.token_hex(2)
    files = attach([attachable(f) for f in a.file or []], pid)
    if files and not text.strip(): text = "Attached: " + ", ".join(f["name"] for f in files)
    p = {"id": pid, "at": now(), "from": a.as_ or os.environ.get("HIVE_NAME", "anon"),
         "to": ["@" + n for n in dict.fromkeys(to)], "thread": a.thread or pid, "text": text}
    if a.model: p["model"] = a.model
    if a.routed: p["routed"] = True
    if a.reply_to: p["reply_to"] = a.reply_to
    if os.environ.get("HIVE_POST_VIA"): p["via"] = os.environ["HIVE_POST_VIA"]
    if re.fullmatch(r"f[0-9a-f]{4}", str(p["from"]).lower()) and (w := [n for n in said if n in FRESH]):
        print(f"hive post: from a free agent, {', '.join(w)} in the text starts nothing: leave the word out and use --to new", file=sys.stderr)
    if files: p["files"] = files
    # The dash passes on what the browser signed. One that doesn't fit is dropped rather than posted with a ✗ on it: posting never waits on a signature.
    if a.as_ == "person" and os.environ.get("HIVE_POST_SIG") and signed():
        try:
            sig = json.loads(os.environ["HIVE_POST_SIG"])
            if (why := _signed.check({**p, "sig": sig}, _nonces, {})).get("state") == "bad": raise ValueError(why["why"])
            p["sig"] = sig
        except ValueError as x: print(f"hive post: posted, but not signed ({x})", file=sys.stderr)
    with BOARD.open("a") as f:
        fcntl.flock(f, fcntl.LOCK_EX); f.write(json.dumps(p) + "\n")
    print(pid, flush=True)
    for k in getattr(a, "done", None) or []:  # the result post closes the ask it delivers: no separate `hive asks done` turn
        subprocess.run([sys.executable, "-I", str(CORE / "asks.py"), "done", k, "--evidence", pid])
    me = (a.as_ or os.environ.get("HIVE_NAME", "")).lower()
    receipt(list(dict.fromkeys(to)), ignored, ext, me)

def cmd_model(a):
    """Carry on with this conversation on another model (the person, 2026-11-04): a post to itself with --model, which the starter queues until this run ends."""
    me = os.environ.get("HIVE_NAME", "").lower()
    if not HASH_NAME.fullmatch(me): sys.exit("hive model: only a running agent can switch its own model")
    try: rec = json.loads((RUN / f"{me}.json").read_text())
    except (OSError, ValueError): sys.exit(f"hive model: no run record for {me}")
    now_on = rec.get("model")
    if rec.get("harness", "claude-code") != "claude-code" or rec.get("fallback") or me.startswith("f") or ":" in str(now_on or ""):
        sys.exit(f"hive model: you're on {now_on or 'a provider'}, and this only moves a Claude run. Hand the work to a stronger agent: hive post --model opus, with a brief")
    if a.to_model == now_on: sys.exit(f"hive model: you're already on {now_on}")
    way = f"{'up' if now_on in CLAUDE_MODELS and CLAUDE_MODELS.index(a.to_model) > CLAUDE_MODELS.index(now_on) else 'down'} from {now_on}" if now_on in CLAUDE_MODELS else f"from {now_on or 'another model'}"
    if a.next:  # no resume: the agent panel's own route (starter.apply_model_sets), so stepping down at a stopping point costs nothing now
        try:
            (STATE / "model-set").mkdir(parents=True, exist_ok=True); (STATE / "model-set" / f"{me}.json").write_text(json.dumps({"model": a.to_model}))
        except OSError as x: sys.exit(f"hive model --next: can't from here ({x.strerror}). Use hive model {a.to_model} and end your turn")
        cmd_post(argparse.Namespace(thread=rec.get("thread"), to=None, model=None, reply_to=None, file=None, as_=None, routed=False, text=[f"Next wake on {a.to_model} ({way}): " + " ".join(a.why)]))
        return
    print(f"Now end your turn: you resume on {a.to_model} in this same conversation. Say what's left in the thread first if it isn't obvious. If no login has room, you wait until one does.", file=sys.stderr)
    cmd_post(argparse.Namespace(thread=rec.get("thread"), to=me, model=a.to_model, reply_to=None, file=None, as_=None, routed=False, text=[f"Switching to {a.to_model} ({way}): " + " ".join(a.why)]))

def cmd_read(a):
    sel = [p for p in posts() if (not a.thread or p.get("thread") == a.thread or p.get("id") == a.thread)
           and (not a.id or p.get("id") == a.id) and since_ok(p, a.since)
           and (not a.from_ or p.get("from") == a.from_) and (not a.to or a.to.lstrip("@").lower() in names(p.get("to")))]
    if a.n and len(sel) > a.n: print(f"({len(sel) - a.n} older posts not shown; -n 0 for all)", file=sys.stderr)
    for p in sel[-a.n:]:
        if a.short: print(f"[{p.get('id')}] {p.get('at', '')[5:16]} {p.get('from')}: " + " ".join(str(p.get("text", "")).split())[:100])
        else: show(p)

def cmd_verify(a):
    """Exit 0 only for a good signature with a key root has pinned. Reads the whole board, so a copied signature shows. A warden should run its own copy of signed.py: this file is the agents' own."""
    p = next((p for p in posts() if p.get("id") == a.id), None)
    if not p: print(f"hive verify: no post {a.id}", file=sys.stderr); sys.exit(2)
    if not signed(): print("hive verify: core/signed.py is missing", file=sys.stderr); sys.exit(2)
    r = _signed.check(p, _nonces)
    print(f"{a.id} from {p.get('from')}: " + (_signed.line(r, p) or "unsigned: a claim, nothing shows who wrote it"))
    if r.get("words") is not None: print("signed words: " + r["words"])
    sys.exit(0 if r["state"] == "pinned" and p.get("from") == "person" else 1)

def cmd_search(a):
    words = [w.lower() for w in a.words]
    for p in posts():
        blob = json.dumps(p).lower()
        if all(w in blob for w in words): show(p)

def cmd_approve(a):
    """An agent asks the person for a yes that no warden can give; the dashboard shows Approve/Deny (a major one asks for a typed x)."""
    me = os.environ.get("HIVE_NAME", "").lower()
    d = STATE / "approvals"
    if a.do == "status":
        f = d / f"{a.id}.json"
        try: print(json.loads(f.read_text())["state"])
        except (OSError, ValueError, KeyError): sys.exit(f"hive approve status: no request {a.id}")
        return
    if not me: sys.exit("hive approve ask: only an agent asks")
    if not a.why.strip() or not a.thread: sys.exit('hive approve ask --thread T [--major] --why "what you want to do, in a plain sentence"')
    aid = os.urandom(4).hex(); d.mkdir(parents=True, exist_ok=True)
    (d / f"{aid}.json").write_text(json.dumps({"id": aid, "from": me, "thread": a.thread, "why": a.why.strip(), "major": bool(a.major), "state": "pending", "at": now()}))
    how = "type x in the box on the dashboard card, then Approve" if a.major else "press Approve on the dashboard card"
    text = f"For you: approve or deny request {aid}: {' '.join(a.why.split())[:180]}\n\nApproval request {aid} from {me}: {a.why.strip()}\n\nTo answer: {how} (or reply here in words if you are not at the dashboard; a typed reply is not the button)."
    r = subprocess.run([sys.executable, str(CORE / "hive"), "post", "--thread", a.thread], input=text, text=True)
    if r.returncode: sys.exit(r.returncode)
    print(aid)
    print(f"Request {aid} is waiting. Check with: hive approve status {aid} (pending|approved|denied). Only the dashboard button sets approved; the person's answer also arrives as a post.", file=sys.stderr)

def cmd_feedback_draft(a):
    """An agent drafts feedback about Hive; the dashboard opens the Send feedback window with it filled in, and the person presses Send (or closes it)."""
    me = os.environ.get("HIVE_NAME", "").lower()
    text = (a.text or sys.stdin.read()).strip()
    if not me or not text: sys.exit("hive feedback-draft: an agent gives the text as an argument or on stdin (quoted heredoc)")
    d = STATE / "feedback-drafts"; d.mkdir(parents=True, exist_ok=True)
    aid = os.urandom(4).hex()
    (d / f"{aid}.json").write_text(json.dumps({"id": aid, "from": me, "text": text[:8000], "at": now()}))
    print(f"Draft {aid} is waiting: the dashboard opens Send feedback with it filled in. Nothing is sent until the person presses Send.")

def cmd_done(a):
    if os.environ.get("HIVE_BROKER"): forward({"verb": "done"})
    me = os.environ.get("HIVE_NAME", "").lower()
    if not me: sys.exit("hive done: no $HIVE_NAME; only an agent can say it's done")
    d = STATE / "done"; d.mkdir(parents=True, exist_ok=True)
    (d / me).write_text("it said its work was finished\n")
    print(f"{me} is marked done: a later message in its thread starts a new agent, unless the person names {me}.")

def cmd_who(a):
    try: c = read_cfg()
    except (OSError, ValueError): c = {}
    for f in sorted(RUN.glob("*.json")):
        r = json.loads(f.read_text())
        try: os.kill(r["pid"], 0); alive = "running"
        except OSError: alive = "gone"
        print(f"@{r['name']:<16} {alive:<8} since {r['at'][:19]}  woken by {r['post']}  login {login_name(c, r['login'])}  model {r.get('model', 'default')}")
    u = STATE / "usage.json"
    try: five = json.loads((STATE / "usage_5h.json").read_text())
    except (OSError, ValueError): five = {}
    if u.exists():
        for k, v in json.loads(u.read_text()).items():
            if k == "_checked": continue
            f = five.get(k) if isinstance(five, dict) else None
            print(f"weekly usage {login_name(c, k)}: {pct(v)}{f', 5-hour {pct(f)}' if f is not None else ''}{' (paused)' if k in paused_logins() else ''}  ({lines_text(c, k)}){runway(c, k, v)}")

def runway(c, path, used):
    """When this login reaches its weekly stop if the week's average burn holds, when that's before it resets. A straight
    line from the start of its week: rough, but enough to see a dark gap coming."""
    try:
        reset = json.loads((STATE / "usage_resets.json").read_text())[path]["weekly"]
        stop = (login_limits().get(path) or {}).get("weekly") or c["usage_stop_pct"]
        t, start = time.time(), reset - 7 * 86400
        if not 0 < used < stop or t - start < 1800 or not t < reset: return ""
        hit = t + (stop - used) * (t - start) / used
        if hit >= reset: return ""
        f = lambda x: dt.datetime.fromtimestamp(x, dt.timezone.utc).strftime("%m-%d %H:%M UTC")
        return f"  [at this rate it stops {f(hit)}, resets {f(reset)}]"
    except (OSError, ValueError, KeyError, TypeError): return ""

def cmd_wait(a):
    """Block until a post made from now on is addressed to --to (default: you) or lands in --thread; print it.
    Run it in the background to be woken: exit 0 on a post, 1 on --timeout."""
    me = os.environ.get("HIVE_NAME", "").lower()
    who, start, end = (a.to or me).lstrip("@").lower(), now(), time.time() + a.timeout
    while time.time() < end:
        got = [p for p in posts() if p.get("at", "") >= start and str(p.get("from", "")).lower() != me
               and ((a.thread and p.get("thread") == a.thread) or (not a.thread and who in names(p.get("to"))))]
        if got:
            for p in got: show(p)
            return
        time.sleep(3)
    print("no post before the timeout"); sys.exit(1)

def starter_proc():
    """A process is running this install's starter.py. starter.json is saved only after each loop, so a door
    opened right after the starter (not under systemd, or just after boot) would otherwise call it stopped."""
    want = str((CORE / "starter.py").resolve())
    for d in Path("/proc").iterdir():
        if not d.name.isdigit(): continue
        try: a = (d / "cmdline").read_bytes().split(b"\0")
        except OSError: continue
        if len(a) > 1 and b"python" in Path(a[0].decode(errors="replace")).name.encode() and a[1]:
            try: arg = Path(a[1].decode(errors="replace"))
            except ValueError: continue
            if not arg.is_absolute():
                try: arg = Path(os.readlink(d / "cwd")) / arg
                except OSError: continue
            try:
                if str(arg.resolve()) == want: return True
            except OSError: pass
    return False

def door(extra):
    """The person's way in: an ordinary Claude Code session in ~, told it is the door (door.md), signed as person.
    `hive` resumes the same conversation, `hive --new` starts another; other args go to claude."""
    st = STATE / "starter.json"
    if (not st.exists() or time.time() - st.stat().st_mtime > 60) and not starter_proc():
        print("Note: the starter isn't running, so posts won't start agents. Try: systemctl --user start hive-starter", file=sys.stderr)
    try: login = str(Path(json.loads((CORE / "config.json").read_text())["logins"][0]).expanduser())
    except (OSError, ValueError, KeyError, IndexError): login = str(HOME / ".claude")
    STATE.mkdir(exist_ok=True)
    f = STATE / "door_session"
    if "--new" in extra or not f.exists(): f.write_text(str(uuid.uuid4()))
    sid, extra = f.read_text().strip(), [x for x in extra if x != "--new"]
    said = any(Path(login, "projects").glob(f"*/{sid}.jsonl"))  # resume only a session that holds a conversation
    system = (CORE / "orientation.md").read_text() + "\n\n" + (CORE / "door.md").read_text()
    os.chdir(HOME)
    os.environ.update(HIVE_NAME="person", HIVE_DOOR="1", CLAUDE_CONFIG_DIR=login)
    if (sb := boxed()):  # the door's model reads what agents write, so it's in the sandbox too; its posts are marked, and approve nothing
        r = sb.check()
        if not r["works"]: sys.exit(f"{r['why']}\n{r['fix']}\nNo agent starts until that's fixed, or until you choose to run without the sandbox (\"sandbox\": \"bare\" in {sb.SETTINGS}).".replace("\n\n", "\n"))
        sb.prepare("person"); sb.ensure_broker(); sb.ready("person")
        cmd, env = sb.wrap(["claude", "--append-system-prompt", system + sb.NOTE + sb.DOOR_NOTE, "--allowedTools", "Bash(hive *)",
                            "--resume" if said else "--session-id", sid, *extra], dict(os.environ), "person")
        os.execvpe(cmd[0], cmd, env)
    os.execvp("claude", ["claude", "--append-system-prompt", system, "--allowedTools", "Bash(hive *)",
                         "--resume" if said else "--session-id", sid, *extra])

def manifest(d):
    try: return json.loads((d / "module.json").read_text())
    except (OSError, ValueError): return {}

def module_blurb(text, cap=160):
    """A module's description for a list: the first sentence, and if that's long, whole words up to a clause. Never cut mid-word."""
    text = " ".join(str(text or "").split())
    first = re.split(r"(?<!e\.g\.)(?<!i\.e\.)(?<!vs\.)(?<=[.!?])\s+", text, maxsplit=1)[0]
    if len(first) <= cap: return first
    cut = first[:cap + 1].rsplit(" ", 1)[0]
    clause = max(cut.rfind(c) for c in (",", ":", ";"))
    if clause >= cap // 2: cut = cut[:clause]
    if cut.count("(") > cut.count(")"): cut = cut[:cut.rfind("(")]
    if cut.count("`") % 2: cut = cut[:cut.rfind("`")]
    return re.sub(r"(\s+(a|an|the|and|or|of|to|from|in|with|for|by))+$", "", cut.rstrip()).rstrip(" ,:;-") + "…"

def catalog():
    """What can be added: core's modules.json (name -> repo, about, needs, recommended) plus what ships in core/modules (default: put in place at install).
    A source tree has neither at its top, only dist/, whose bundled folders hold manifests without the code: those count only if already installed."""
    released = (CORE / "modules.json").exists() or (CORE / "modules").is_dir()
    pub = CORE if released else CORE / "dist"
    try: c = json.loads((pub / "modules.json").read_text())
    except (OSError, ValueError): c = {}
    for d in sorted((pub / "modules").glob("*/")):
        if released or (MODULES / d.name).is_dir():
            m = manifest(d); c.setdefault(d.name, {"about": m.get("description", ""), "bundled": True, "default": bool(m.get("default")), "recommended": bool(m.get("recommended"))})
    return c

def module_rows():
    """Every module the app shows. source: included (ships with the release), public (in its catalog), own (anything else here: made on this Hive, or added by URL)."""
    cat, rows = catalog(), []
    for n, c in cat.items():
        d = MODULES / n
        rows.append({"name": n, "state": "installed" if d.is_dir() else "available", "source": "included" if c.get("bundled") else "public", "about": module_blurb(manifest(d).get("description") or c.get("about")), "needs": c.get("needs"), "default": bool(c.get("default")), "recommended": bool(c.get("recommended"))})
    for d in sorted(MODULES.glob("*/")):
        if d.name not in cat and (d / "module.json").exists():
            rows.append({"name": d.name, "state": "installed", "source": "own", "about": module_blurb(manifest(d).get("description")), "needs": None, "default": False, "recommended": False})
    return rows

MODULE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*")  # a folder in ~/modules or a command in ~/.local/bin: never a path, and never ..

def module_links(d):
    """(link, target) pairs a module wants: its commands on PATH, its skills in each login."""
    m, out = manifest(d), []
    bins = {k: d / v for k, v in m.get("bin", {}).items() if MODULE_NAME.fullmatch(k)} or {f.name: f for f in sorted((d / "bin").glob("*")) if os.access(f, os.X_OK) and f.is_file()}
    out += [(BIN / k, t) for k, t in bins.items()]
    try: logins = json.loads((CORE / "config.json").read_text())["logins"]
    except (OSError, ValueError, KeyError): logins = ["~/.claude"]
    for s in m.get("provides", {}).get("skills", []):
        out += [(Path(l).expanduser() / "skills" / Path(s).parent.name, (d / s).parent) for l in logins]
    return out

def cmd_module(a):
    """Modules are optional folders in ~/modules with a module.json: commands, skills, docs. The core never uses them."""
    cat = catalog()
    if a.do == "list" and a.json: print(json.dumps(module_rows())); return
    if a.do == "list":
        have = sorted(d for d in MODULES.glob("*/") if (d / "module.json").exists())
        for d in have: print(f"{d.name:<14} installed  {module_blurb(manifest(d).get('description'))}")
        for n, c in cat.items():
            if not (MODULES / n).exists(): print(f"{n:<14} available  {module_blurb(c.get('about'))}" + (f" [needs {c['needs']}]" if c.get("needs") else ""))
        return
    if not a.name: sys.exit(f"hive module {a.do}: name which module")
    name = re.sub(r"\.git$", "", a.name.rstrip("/").rsplit("/", 1)[-1]).removeprefix("hive-")
    if not MODULE_NAME.fullmatch(name): sys.exit(f"hive module {a.do}: {a.name} isn't a module's name or a git URL")
    d = MODULES / name
    if a.do == "remove":
        if not d.is_dir(): sys.exit(f"{name} isn't installed")
        if (d / ".git").exists() and subprocess.run(["git", "-C", str(d), "status", "--porcelain"], capture_output=True, text=True).stdout.strip():
            sys.exit(f"{d} has uncommitted changes; commit or discard them first")
        for link, _ in module_links(d): link.unlink(missing_ok=True)
        shutil.rmtree(d); print(f"removed {name}")
        return
    if not d.exists():
        MODULES.mkdir(exist_ok=True)
        c = cat.get(a.name, {})
        if c.get("bundled"): shutil.copytree(CORE / "modules" / a.name, d)
        else:
            url = c.get("repo") or (a.name if "/" in a.name else None)
            if not url: sys.exit(f"no module {a.name}; see hive module list, or give a git URL")
            if subprocess.run(["git", "clone", "-q", "--depth", "1", url, str(d)]).returncode:
                shutil.rmtree(d, ignore_errors=True); sys.exit(f"couldn't clone {url}; {a.name} wasn't added")
    if not manifest(d): print(f"note: {d} has no module.json, so nothing was linked")
    for link, target in module_links(d):
        link.parent.mkdir(parents=True, exist_ok=True)
        link.unlink(missing_ok=True); link.symlink_to(target); print(f"linked {link} -> {target}")
    m = manifest(d)
    print(f"{name}: {m.get('description', '')[:300]}")
    for doc in m.get("provides", {}).get("procedures", []) or ["README.md"]: print(f"read first: {d / doc}")
    needs = cat.get(a.name, {}).get("needs")
    if needs: print(f"needs: {needs}")

def cmd_update(a):
    """Everything is in update.py, which also runs alone from the timer."""
    os.execv(sys.executable, [sys.executable, str(CORE / "update.py")] + (["--check"] if a.check else []) + (["--auto"] if a.auto else []))

def cmd_share(a):
    """One conversation as one page to post (the app's Share this result). The page-maker is the dash's share.py; nothing is uploaded."""
    f = MODULES / "dash" / "share.py"
    if not f.exists(): sys.exit("hive share: the app (module dash) isn't installed here")
    os.execv(sys.executable, [sys.executable, str(f)] + a.rest)

def cmd_web(a):
    """The local web app's address. The app is on only where ~/.hive/web.json exists: install makes it (--setup), with a new secret."""
    f = STATE / "web.json"
    try: web = json.loads(f.read_text())
    except OSError: web = None
    except ValueError: sys.exit(f"{f} can't be read; fix or delete it, then run hive web --setup")
    if web is None and not a.setup: sys.exit("The web app isn't set up on this account (hive web --setup does that).")
    # Recovery on an installed Hive: the running app holds the old port and refuses everything, so stop it first or setup would move the port.
    recover = web is None and a.setup and (Path.home() / ".hive-installed").exists() and shutil.which("systemctl")
    def dash(verb):
        try: subprocess.run(["systemctl", "--user", verb, "hive-dash"], capture_output=True, timeout=30)
        except subprocess.TimeoutExpired: pass
    if recover: dash("stop")
    if web is None:
        web = {"port": next(p for p in range(8077, 8177) if port_free(p))}
    if a.setup and not web.get("secret") or a.new_secret: web["secret"] = secrets.token_urlsafe(32)
    if a.setup or a.new_secret:
        STATE.mkdir(exist_ok=True)
        t = STATE / f".web.json.{os.getpid()}"
        t.touch(mode=0o600); t.chmod(0o600); t.write_text(json.dumps(web, indent=1) + "\n"); t.replace(f)
        if a.new_secret: print("New secret: every browser has to open the new address, and the old one no longer works.", file=sys.stderr)
    port = web.get("port", 8077)
    if recover:
        dash("start")
        for _ in range(50):  # the service manager returns before the app has bound its port
            if not port_free(web["port"]): break
            time.sleep(0.1)
    if a.setup and not recover: return
    print(f"http://localhost:{port}/login#{web['secret']}")
    if port_free(port): print(f"The app isn't running. Start it: systemctl --user start hive-dash  (or: python3 ~/modules/dash/dash.py serve)", file=sys.stderr)
    print(f"That address is the key to this hive, so keep it to yourself. On another machine: ssh -L {port}:127.0.0.1:{port} <this-machine>, then open it there.", file=sys.stderr)

def cmd_open(a):
    """Open the app in the browser, starting it first if it's stopped. What the launcher icon runs, so nobody needs a terminal to come back."""
    try: web = json.loads((STATE / "web.json").read_text())
    except (OSError, ValueError): sys.exit("The web app isn't set up on this account (hive web --setup does that).")
    port = web.get("port", 8077)
    if port_free(port) and shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "start", "hive-dash"], capture_output=True, timeout=30)
    for _ in range(150):  # up to 30 s: the service manager returns before the app has bound its port
        if not port_free(port): break
        time.sleep(0.2)
    else: sys.exit(f"The app didn't start. Look at: systemctl --user status hive-dash")
    # The sign-in address when this account can read it (it sets the browser's cookie); the plain address otherwise, which a browser that has signed in before still accepts.
    url = f"http://localhost:{port}/login#{web['secret']}" if web.get("secret") else f"http://localhost:{port}/"
    if a.print: return print(url)
    for b in (["xdg-open"], ["open"], ["wslview"]):
        if shutil.which(b[0]): subprocess.Popen(b + [url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True); return
    print(f"No browser to open. Open this yourself: {url}")

def port_free(p):
    with socket.socket() as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try: s.bind(("127.0.0.1", p)); return True
        except OSError: return False

DONE = re.compile(r"\b(done|merged|closed|released|shipped|fixed|no action|nothing to do|stopping)\b", re.I)

def jobs_of(name):
    """Live processes that carry HIVE_NAME=name (nohup'd sims and waiters too)."""
    key, n = f"HIVE_NAME={name}".encode(), 0
    for d in Path("/proc").iterdir():
        try: n += d.name.isdigit() and key in (d / "environ").read_bytes().split(b"\0")
        except OSError: pass
    return n

NAMED = re.compile(r"(?<![\w.`])@([a-z][0-9a-f]{4})\b")
QUESTION = re.compile(r"\?\s*$")

def open_in(t, ps, asks, ext, last_post=None):
    """Why a quiet thread is still open, or None if it is only resting (an agent's result with nothing waiting on anyone).
    Open: an open ask or leftover filed for it; the person or the other Hives spoke last; the last agent post asks the person
    or the other Hives; it names an agent that never posted anywhere after it (last_post: {name: latest post time}); or it
    ends with a question. The old count (187 on 2026-11-04) was mostly resting threads, so the keeper's lead and the
    progress number said nothing."""
    last = ps[-1]; frm = str(last.get("from", "")).lower(); text = str(last.get("text", ""))
    if asks.get(t): return f"open ask {' '.join(sorted(asks[t]))}"
    if frm in ("person", "hives"): return f"{frm} spoke last"
    if frm in ext: return None
    plain = CODE.sub(" ", text)
    if re.search(r"(?<![\w.`])@(person|hives)\b", plain) and ("?" in plain or re.search(r"^\s*For you:", plain, re.M)):  # a result that only pings them is resting: 22 of 23 such threads on 2026-11-04
        return "asked the person" if "@person" in plain else "asked the hives"
    named = [n for n in dict.fromkeys(NAMED.findall(plain)) if n != frm and (last_post or {}).get(n, "") <= str(last.get("at", ""))]
    if named: return f"named {' '.join(named)}, no reply"  # not a word anywhere since: one who went on elsewhere saw it (17 of 19 on 2026-11-04), as the watchdog's handoff check reads it
    if QUESTION.search(plain.strip()): return "ends with a question"
    return None

def open_asks_by_thread():
    """Open asks and leftovers from ~/asks.jsonl, by thread: {thread: {id, ...}}."""
    out = {}
    try:
        sys.path.insert(0, str(CORE)); import asks as A
        for e in A.open_items(A.ledger()):
            th = e.get("thread") or e.get("post")
            if th: out.setdefault(th, set()).add(e["id"])
    except Exception: pass
    return out

def cmd_stalled(a):
    """Threads gone quiet with something still open in them (see open_in): last post older than --quiet, newer than --within,
    nobody in it running or queued, and the last post doesn't read as finished. --all lists resting threads too, as before
    2026-11-04. A lead for the keeper, not a verdict."""
    def ago(s):
        m = re.fullmatch(r"(\d+)([mhd])", s); return dt.timedelta(**{{"m": "minutes", "h": "hours", "d": "days"}[m[2]]: int(m[1])})
    t_now = dt.datetime.now(dt.timezone.utc)
    quiet, within = (t_now - ago(a.quiet)).isoformat(), (t_now - ago(a.within)).isoformat()
    threads = {}
    for p in posts(): threads.setdefault(p.get("thread") or p.get("id"), []).append(p)
    try: st = json.loads((STATE / "starter.json").read_text())
    except (OSError, ValueError): st = {}
    queued = set(st.get("pending", {})) | set(st.get("resume", {}))
    live = set()
    for f in RUN.glob("*.json"):
        try: r = json.loads(f.read_text()); os.kill(r["pid"], 0); live.add(r["name"])
        except (OSError, ValueError, KeyError): pass
    ext = {"person", "starter", "watchdog", "anon", "all"}
    asks = {} if a.all else open_asks_by_thread()
    last_post = {}
    for p in posts(): last_post[str(p.get("from", "")).lower()] = max(last_post.get(str(p.get("from", "")).lower(), ""), str(p.get("at", "")))
    for t, ps in sorted(threads.items(), key=lambda kv: kv[1][-1].get("at", "")):
        last = ps[-1]
        if not (within < last.get("at", "") < quiet) or t in ("keeper", "side"): continue
        who = list(dict.fromkeys(str(p.get("from", "")).lower() for p in ps if str(p.get("from", "")).lower() not in ext))
        if not who or any(w in live or w in queued for w in who): continue
        if DONE.search(str(last.get("text", ""))[:300]) and last.get("from") not in ("person", "hives"): continue
        why = open_in(t, ps, asks, ext, last_post)
        if not why and not a.all: continue
        jobs = {w: jobs_of(w) for w in who}
        print(f"{t}  last {last.get('at','')[:16]} by {last.get('from')}  agents {' '.join(who[-4:])}" + (f"  open: {why}" if why else "  resting")
              + (f"  jobs alive: {', '.join(f'{w}:{n}' for w, n in jobs.items() if n)}" if any(jobs.values()) else "")
              + "\n  " + str(last.get("text", ""))[:240].replace("\n", " "))

# ---------- logins ----------

def read_cfg(): return json.loads((CORE / "config.json").read_text())

def post_model(m):
    """--model: a Claude alias, or provider:model where provider is in config.json's providers (see starter.provider_of)."""
    if m in CLAUDE_MODELS: return m
    try: provs = read_cfg().get("providers", {})
    except (OSError, ValueError): provs = {}
    if re.match(r"^([a-z0-9-]+):([A-Za-z0-9][A-Za-z0-9._/:@-]*)$", m) and m.split(":", 1)[0] in provs: return m
    raise argparse.ArgumentTypeError(f"{m!r}: use {', '.join(CLAUDE_MODELS)} or provider:model with a provider from {sorted(provs) or 'config.json providers (none set)'}")

def write_cfg(c):
    t = CORE / f".config.json.{os.getpid()}"
    t.write_text(json.dumps(c, indent=2) + "\n"); t.replace(CORE / "config.json")  # the starter reads it every poll

def login_name(c, path):
    """A login's short name: login_names in config.json, by path; else its directory's name."""
    path = str(Path(path).expanduser())
    for k, v in (c.get("login_names") or {}).items():
        if str(Path(k).expanduser()) == path: return v
    return Path(path).name.removeprefix(".claude-").lstrip(".")

def login_env(d):
    return {**{k: v for k, v in os.environ.items() if k not in ("ANTHROPIC_API_KEY", "HIVE_NAME")}, "CLAUDE_CONFIG_DIR": str(d)}

def login_status(d):
    """What `claude auth status` says about login dir d, {} if not signed in. Uses no model usage."""
    try:
        s = json.loads(subprocess.run(["claude", "auth", "status", "--json"], env=login_env(d), capture_output=True, text=True, timeout=30).stdout)
        return s if s.get("loggedIn") else {}
    except (OSError, ValueError, subprocess.SubprocessError): return {}

def login_weekly(d):
    """The login's weekly usage %, live; None if unknown. The same read as the starter's, and it never refreshes a token."""
    try:
        tok = json.loads((Path(d) / ".credentials.json").read_text())["claudeAiOauth"]["accessToken"]
        req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
            "Authorization": f"Bearer {tok}", "anthropic-beta": "oauth-2025-04-20"})
        w = json.load(urllib.request.urlopen(req, timeout=15))["seven_day"]
        return w.get("used_percentage", w.get("utilization"))
    except Exception: return None

def login_weekly_known(d):
    """login_weekly, or the starter's last good reading if the live read fails (a 429 here read as "unknown" while the starter had the figure)."""
    v = login_weekly(d)
    if v is not None: return v
    try: return json.loads((STATE / "usage.json").read_text()).get(str(Path(d).expanduser()))
    except (OSError, ValueError, AttributeError): return None

def pct(v): return "unknown" if v is None else f"{v:.0f}%"

def paused_logins():
    """Login paths paused by the person (~/.hive/paused.json): still read for usage, never picked by the starter."""
    try:
        v = json.loads((STATE / "paused.json").read_text())
        return v if isinstance(v, list) else []
    except (OSError, ValueError): return []

def set_paused(path, on):
    v = [x for x in paused_logins() if x != path] + ([path] if on else [])
    STATE.mkdir(exist_ok=True)
    t = STATE / f".paused.json.{os.getpid()}"
    t.write_text(json.dumps(v, indent=1)); t.replace(STATE / "paused.json")  # the starter reads it every poll

def login_limits():
    """Per-login stop lines (~/.hive/login_limits.json): {login path: {"weekly": N, "five_hour": N}}. See starter.stop_lines."""
    try:
        v = json.loads((STATE / "login_limits.json").read_text())
        return v if isinstance(v, dict) else {}
    except (OSError, ValueError): return {}

def set_limit(path, key, v):
    """Set (a number, clamped to 0-100) or clear (None) one stop line. A line above the global one is the person's to set."""
    allv = login_limits(); mine = allv.get(path) if isinstance(allv.get(path), dict) else {}
    if v is None: mine.pop(key, None)
    else: mine[key] = min(100.0, max(0.0, float(v)))
    if mine: allv[path] = mine
    else: allv.pop(path, None)
    STATE.mkdir(exist_ok=True)
    t = STATE / f".login_limits.json.{os.getpid()}"
    t.write_text(json.dumps(allv, indent=1)); t.replace(STATE / "login_limits.json")  # the starter reads it every poll

def lines_text(c, path):
    m = login_limits().get(path) or {}
    w, h = m.get("weekly"), m.get("five_hour")
    return f"stop at {pct(w) if w is not None else str(c.get('usage_stop_pct', '?')) + '% (global)'} weekly, " + (f"{pct(h)} 5-hour" if h is not None else "no 5-hour stop")

def login_add(name, paused=False):
    c = read_cfg()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name): sys.exit("A login name is lowercase letters, digits and dashes, like cc3.")
    listed = {login_name(c, l): l for l in c["logins"]}
    if name in listed: sys.exit(f"{name} is already a login ({listed[name]}).")
    d = HOME / f".claude-{name}"
    if not login_status(d):
        if not sys.stdin.isatty(): sys.exit("Signing in needs a terminal: run this yourself, as this account.")
        print(f"Sign in with the account for {name}. If no browser opens, open the link it prints, then paste the code back here.")
        d.mkdir(exist_ok=True, mode=0o700)
        subprocess.run(["claude", "auth", "login", "--claudeai"], env=login_env(d))
    st = login_status(d)
    if not st: sys.exit(f"{name} isn't signed in, so nothing changed. Run the command again to retry.")
    for other, l in listed.items():  # the same account twice would look like room it doesn't have
        if login_status(Path(l).expanduser()).get("email") == st.get("email"):
            sys.exit(f"That account ({st.get('email')}) is already login {other}, so nothing changed. "
                     f"To use another account: CLAUDE_CONFIG_DIR={d} claude auth logout, then run this again.")
    f, first = d / "settings.json", Path(c["logins"][0]).expanduser() / "settings.json"
    if not f.exists() and first.exists():  # the same settings as the first login; the starter adds the hooks itself
        s = json.loads(first.read_text()); s.pop("hooks", None); f.write_text(json.dumps(s, indent=2) + "\n")
    used = login_weekly(d)
    stop = c["usage_stop_pct"]
    if used is None or used < 100:  # a real one-word run, with the flags agents run with, on the cheapest model
        with tempfile.TemporaryDirectory() as cwd:
            r = subprocess.run(["claude", "-p", "Reply with the single word ok.", "--model", "haiku", *c["claude_args"]], cwd=cwd,
                               env=login_env(d), capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=180)
        if r.returncode and not re.search(r"usage limit|rate limit|hit your limit|limit reached|out of (extra )?usage", r.stdout + r.stderr, re.I):
            sys.exit(f"A test run on {name} failed, so it wasn't added (exit {r.returncode}):\n{(r.stdout + r.stderr)[-800:]}")
    c = read_cfg()  # again: the config may have changed during the sign-in
    home = str(d).replace(str(HOME), "~", 1)
    if paused: set_paused(str(d), True)  # before the config, so the starter never sees it unpaused
    c["logins"].append(home); c.setdefault("login_names", {})[home] = name
    write_cfg(c)
    room = used is None or used < stop
    print(f"Added {name} ({st.get('email')}, {st.get('subscriptionType') or 'plan unknown'}), weekly usage {pct(used)}.")
    print(f"It's paused, so the starter won't use it. To start using it: hive login resume {name}, or Resume on the dashboard." if paused else
          f"The starter uses it within {c['usage_check_s'] // 60} min" + (", for new runs, whichever login has the most room."
          if room else f" once it's under the {stop}% stop line."))
    print("It shows on the dashboard's Usage tab, in `hive who` and in `hive login list`.")
    text = (f"Login {name} is added but paused, by `hive login add --paused`: the starter won't use it, and the hold in kb/priorities.md stands." if paused else
            f"Login {name} is added (weekly usage {pct(used)}, stop line {stop}%), by `hive login add`. New runs go to whichever login has the most room. "
            + "The hold in kb/priorities.md stands: a new login doesn't lift it, only the person does.")
    cmd_post(argparse.Namespace(text=[text], to=None, thread="keeper", as_="hive-login", model=None, file=None, reply_to=None, routed=False))

def cmd_login(a):
    if a.do == "add":
        if not a.name: sys.exit("Usage: hive login add NAME  (for example: hive login add cc3)")
        return login_add(a.name, a.paused)
    c = read_cfg()
    if a.do in ("pause", "resume"):
        hit = [l for l in c["logins"] if a.name == login_name(c, l)]
        if not hit: sys.exit(f"Usage: hive login {a.do} NAME. No login called {a.name}. See: hive login list")
        set_paused(str(Path(hit[0]).expanduser()), a.do == "pause")
        print(f"{a.name} is {'paused: its usage is still read, runs on it finish, and the starter gives it no new ones' if a.do == 'pause' else 'back in use'}.")
        return
    if a.do == "limit":
        hit = [l for l in c["logins"] if a.name == login_name(c, l)]
        if not hit or (a.weekly is None and a.five_hour is None):
            sys.exit("Usage: hive login limit NAME [--weekly N|off] [--five-hour N|off]. Stop giving NAME runs at N% of its weekly "
                     "or 5-hour limit (off: weekly back to the global line, no 5-hour stop). A line above the global "
                     f"{c['usage_stop_pct']}% is the person's to set, not an agent's.")
        path = str(Path(hit[0]).expanduser())
        for key, v in (("weekly", a.weekly), ("five_hour", a.five_hour)):
            if v is None: continue
            if v.lower() in ("off", "none", "-"): set_limit(path, key, None); continue
            try: set_limit(path, key, float(v.rstrip("%")))
            except ValueError: sys.exit(f"{v} isn't a number or off.")
        print(f"{a.name}: {lines_text(c, path)}. Your own posts still start runs past these lines, up to a real limit.")
        return
    if a.do == "rename":
        if not a.name or not a.new: sys.exit("Usage: hive login rename OLD NEW")
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", a.new): sys.exit("A login name is lowercase letters, digits and dashes, like cc3.")
        if a.new in (login_name(c, l) for l in c["logins"]): sys.exit(f"{a.new} is already a login.")
        hit = [l for l in c["logins"] if a.name == login_name(c, l)]
        if not hit: sys.exit(f"No login called {a.name}. See: hive login list")
        c.setdefault("login_names", {})[hit[0]] = a.new
        write_cfg(c); print(f"{a.name} is now {a.new} ({hit[0]}). Only the name changed.")
        return
    for l in c["logins"]:
        d = Path(l).expanduser(); st = login_status(d)
        print(f"{login_name(c, l):<12} {l:<20} weekly {pct(login_weekly_known(d)):<8} {st.get('subscriptionType') or '':<8} {st.get('email') or 'NOT SIGNED IN'}{'  PAUSED' if str(d) in paused_logins() else ''}  ({lines_text(c, str(d))})")

