def cmd_sandbox(a):
    """The check the installer and the setup screens read. Words exit 1 when it doesn't work. --json exits 0 with an answer in "works": the app takes any other exit as no answer."""
    if os.environ.get("HIVE_BROKER"): r = {"works": True, "why": "This is already inside the sandbox.", "fix": ""}
    else: r = box().check()
    if a.json: print(json.dumps(r)); return
    if r["works"]: print("The sandbox works on this machine." if not r["why"] else r["why"]); return
    print(f"The sandbox doesn't work on this machine. {r['why']}")
    if r["fix"]: print(r["fix"])
    if not box().on(): print("This Hive isn't set to use the sandbox, so this doesn't stop agents starting: they have the full rights of this account."); sys.exit(1)
    print(f"No agent starts until that's fixed, or until you choose to run without the sandbox (\"sandbox\": \"bare\" in {HOME / 'settings.json'}): agents then have the full rights of this account.")
    sys.exit(1)

def steps():
    out = []
    for f in sorted((STATE / "steps").glob("*/step.json")):
        try: out.append(json.loads(f.read_text()))
        except (OSError, ValueError): pass
    return out

def cmd_step(a):
    """Ask for something to run outside the sandbox (from inside), or answer one (from outside: the person's own terminal)."""
    inside = bool(os.environ.get("HIVE_BROKER"))
    if a.do == "ask":
        if not inside: sys.exit("hive step ask: only from inside the sandbox; out here there's nothing to leave")
        if not a.id_or_script and not a.script: sys.exit("hive step ask --why \"what and why\" --script PATH")
        forward({"verb": "ask", "why": a.why}, [a.script or a.id_or_script])
    if a.do == "verdict":
        if not inside: sys.exit("hive step verdict: only a warden judging a step, inside the sandbox")
        forward({"verb": "verdict", "id": a.id_or_script, "verdict": a.verdict, "why": a.why})
    if a.do == "status" and inside: forward({"verb": "status"})
    if inside: sys.exit(f"hive step {a.do}: that's the person's, from outside the sandbox")
    if a.do in ("status", "list"):
        for s in steps(): print(f"{s['id']} {s['state']} from {s['from']}: " + " ".join(str(s.get("why", "")).split())[:100])
        return
    if not a.id_or_script: sys.exit(f"hive step {a.do} ID")
    s = next((s for s in steps() if s["id"] == a.id_or_script), None)
    if not s: sys.exit(f"hive step {a.do}: no step {a.id_or_script}")
    if s["state"] != "person": sys.exit(f"hive step {a.do}: step {s['id']} isn't waiting for you ({s['state']})")
    r = subprocess.run([sys.executable, str(CORE / "hive"), "post", "--as", "person", "--thread", s.get("thread") or f"step-{s['id']}"],
                       input=f"{a.do} step {s['id']}-{s['sha'][:8]}", text=True)
    sys.exit(r.returncode)

def cmd_bringup(a):
    """hive show THREAD --why "..." [--for 10m]: put a thread in the dashboard's "Brought up for you" strip so the person can click straight in."""
    th = (a.thread or "").lstrip("#")
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.:-]{0,100}", th): sys.exit("hive show: give a thread name (letters, digits and . _ : -)")
    m = re.fullmatch(r"(\d+)([mh]?)", a.for_ or "10m")
    if not m: sys.exit("hive show: --for is minutes or hours, like 10m or 1h")
    secs = int(m.group(1)) * (3600 if m.group(2) == "h" else 60)
    if not 60 <= secs <= 86400: sys.exit("hive show: --for between 1m and 24h")
    if not any(p.get("thread") == th for p in posts()): sys.exit(f"hive show: no thread named {th} on the board (hive search words to find it)")
    t = time.time(); why = " ".join((a.why or "").split())[:200]
    rec = {"thread": th, "from": os.environ.get("HIVE_NAME", "anon"), "why": why, "at": t, "until": t + secs}
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "shown.jsonl", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX); f.write(json.dumps(rec) + "\n")
    print(f"brought up {th} for {secs // 60} min")

def cmd_important(a):
    """hive important THREAD --why "..." [--off]: mark a thread important for the person; the dashboard lists it with an icon and under the Important filter."""
    th = (a.thread or "").lstrip("#")
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.:-]{0,100}", th): sys.exit("hive important: give a thread name (letters, digits and . _ : -)")
    if not any(p.get("thread") == th for p in posts()): sys.exit(f"hive important: no thread named {th} on the board (hive search words to find it)")
    rec = {"thread": th, "from": os.environ.get("HIVE_NAME", "anon"), "why": " ".join((a.why or "").split())[:200], "at": time.time()}
    if a.off: rec["off"] = True
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "important.jsonl", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX); f.write(json.dumps(rec) + "\n")
    print(("took the important mark off " if a.off else "marked important: ") + th)

def cmd_fade(a):
    """hive fade THREAD --why "..." [--off]: mark a thread as likely not needed by the person any more; the dashboard greys it in the list, still there to open and write in."""
    th = (a.thread or "").lstrip("#"); why = " ".join((a.why or "").split())[:200]
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.:-]{0,100}", th): sys.exit("hive fade: give a thread name (letters, digits and . _ : -)")
    if not any(p.get("thread") == th for p in posts()): sys.exit(f"hive fade: no thread named {th} on the board (hive search words to find it)")
    if not a.off and not why: sys.exit('hive fade: say why the person no longer needs it, --why "..." (they read it on the greyed row)')
    rec = {"thread": th, "from": os.environ.get("HIVE_NAME", "anon"), "why": why, "at": time.time()}
    if a.off: rec["off"] = True
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "faded.jsonl", "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX); f.write(json.dumps(rec) + "\n")
    print(("took the not-needed mark off " if a.off else "greyed as likely not needed: ") + th)

def cmd_status(a):
    """hive status THREAD [text on stdin]: set or read the two-line status bar the dashboard shows at the top of a thread."""
    th = (a.thread or "").lstrip("#")
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.:-]{0,100}", th): sys.exit("hive status: give a thread name (letters, digits and . _ : -)")
    f_ = STATE / "thread-status.jsonl"
    if a.read or sys.stdin.isatty():
        best = None
        try:
            for ln in f_.read_text().splitlines():
                try: r = json.loads(ln)
                except ValueError: continue
                if r.get("thread") == th: best = r
        except OSError: pass
        print(best["text"] if best else "(no status yet)"); return
    text = "\n".join(l.strip() for l in sys.stdin.read().strip().splitlines() if l.strip())[:400]
    if not text: sys.exit("hive status: empty text; give two short lines on stdin: what the thread is about, then where it stands now")
    if not any(p.get("thread") == th for p in posts()): sys.exit(f"hive status: no thread named {th} on the board")
    rec = {"thread": th, "from": os.environ.get("HIVE_NAME", "anon"), "text": text, "at": time.time()}
    STATE.mkdir(parents=True, exist_ok=True)
    with open(f_, "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX); f.write(json.dumps(rec) + "\n")
    print(f"status set on {th}")

def cmd_rename(a):
    """hive rename THREAD "new title": give a thread a clearer title in the dashboard; the person's own rename wins over it."""
    th = (a.thread or "").lstrip("#"); title = " ".join(a.title.split())[:80]
