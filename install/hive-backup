#!/bin/sh
# hive-backup: a small nightly copy of the Hive's state to
# ~/hive-backups/<UTC date>, keeping the last 7 (the person, 10-30: "a small
# nightly backup of the Hive's state: the journal, config, goals and the KB").
#
#   events.jsonl.zst  the journal, compressed
#   config.json       the Hive's settings
#   goals/<project>/  each project's goals.md, lessons.md and project.json
#   kb.tar.zst        the knowledge base without record/, which is filed
#                     from the journal again
#   repos/<project>.bundle  a git bundle of every ref in each private repo's
#                     clone: on the free plan a private repo can't carry the
#                     keep-history ruleset and the agents' tokens can
#                     force-push it, so this is its way back
#                     (`git clone repos/<project>.bundle`). Public repos keep
#                     their history on the forge and aren't copied.
#   SHA256SUMS        of the above
#
# It can't fill the disk: it refuses when the inputs (an upper bound on the
# copy) pass MAX_MB, or when the copy would leave less than MIN_FREE_MB free.
# A copy is written beside its place and moved in only when whole and
# checked; old ones are removed only after that. Run by hive-backup.timer;
# by hand: `systemctl --user start hive-backup`.
set -eu

HIVE=${HIVE_HOME:-$HOME/hive}
OUT=${HIVE_BACKUPS:-$HOME/hive-backups}
KEEP=${HIVE_BACKUPS_KEEP:-7}
MAX_MB=${HIVE_BACKUP_MAX_MB:-4096}
MIN_FREE_MB=${HIVE_BACKUP_MIN_FREE_MB:-20480}

say() { echo "hive-backup: $*"; }
die() { say "$*" >&2; exit 1; }

[ -f "$HIVE/.hive/events.jsonl" ] || die "no journal at $HIVE/.hive/events.jsonl"
mkdir -p "$OUT"

# private <dir> says whether a project's repo is private: GitHub answers an
# unauthenticated look at a private repo with 404. Anything it can't tell (no
# answer, another forge) counts as private, so it is kept rather than lost.
private() {
	url=$(git -C "$1" config --get remote.origin.url 2>/dev/null) || return 0
	case "$url" in
	https://github.com/*) repo=${url#https://github.com/} ;;
	git@github.com:*) repo=${url#git@github.com:} ;;
	*) return 0 ;;
	esac
	repo=${repo%.git}
	code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "https://api.github.com/repos/$repo") || return 0
	[ "$code" != 200 ]
}
bundles=""
for p in "$HIVE"/projects/*/; do
	[ -d "$p.git" ] && private "$p" && bundles="$bundles ${p%/}"
done

need=$(( $(du -sm "$HIVE/.hive/events.jsonl" | cut -f1) + $(du -sm --exclude=record "$HIVE/.hive/kb" | cut -f1) + 1 ))
for p in $bundles; do need=$(( need + $(du -sm "$p/.git" | cut -f1) )); done
free=$(df -Pm "$OUT" | awk 'NR==2 {print $4}')
[ "$need" -le "$MAX_MB" ] || die "refused: the inputs are ${need} MB, over the ${MAX_MB} MB cap"
[ $((free - need)) -ge "$MIN_FREE_MB" ] || die "refused: ${free} MB free, and a copy of up to ${need} MB would leave under ${MIN_FREE_MB} MB"

day=$(date -u +%Y-%m-%d)
dest="$OUT/$day"
tmp="$OUT/.$day.partial"
rm -rf "$tmp"
mkdir -p "$tmp/goals"
trap 'rm -rf "$tmp"' EXIT

# Through stdin: the daemon appends to the journal while it is read, and zstd
# refuses a named file that grows under it.
zstd -q -3 -T2 -c < "$HIVE/.hive/events.jsonl" > "$tmp/events.jsonl.zst"
cp -p "$HIVE/.hive/config.json" "$tmp/config.json"
for p in "$HIVE"/projects/*/; do
	name=$(basename "$p")
	for f in goals.md lessons.md project.json; do
		if [ -f "$p.hive/$f" ]; then
			mkdir -p "$tmp/goals/$name"
			cp -p "$p.hive/$f" "$tmp/goals/$name/$f"
		fi
	done
done
tar -C "$HIVE/.hive" --exclude=kb/record -cf - kb | zstd -q -3 -T2 -o "$tmp/kb.tar.zst"
for p in $bundles; do
	mkdir -p "$tmp/repos"
	b="$tmp/repos/$(basename "$p").bundle"
	git -C "$p" -c core.fsmonitor=false bundle create -q "$b" --all || die "can't bundle $p"
	git -C "$p" bundle verify -q "$b" >/dev/null 2>&1 || die "the bundle of $p doesn't check"
done

zstd -q -t "$tmp/events.jsonl.zst" "$tmp/kb.tar.zst" || die "a compressed file doesn't check"
(cd "$tmp" && find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS)

rm -rf "$dest"
mv "$tmp" "$dest"
trap - EXIT
say "$dest: $(du -sh "$dest" | cut -f1)"

# The last KEEP copies stay; older ones go, only now that this one is whole.
ls -1d "$OUT"/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] 2>/dev/null | sort | head -n "-$KEEP" | while read -r old; do
	rm -rf "$old"
	say "removed $old"
done
