[Unit]
Description=Hive buy sweep: delete one-time card files whose buy ended, expired or is over 6 h old, and cancel those cards at Link (warden 11231556881e)

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TMPDIR=%h/.cache/hive-tmp
Type=oneshot
Nice=15
UMask=0077
ExecStart=/usr/bin/python3 -I %h/core/buy.py sweep
