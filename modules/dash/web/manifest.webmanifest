{
  "name": "Hive",
  "short_name": "Hive",
  "description": "Your Hive of AI agents.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1b1917",
  "theme_color": "#1b1917",
  "share_target": {
    "action": "./share-in",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"title": "title", "text": "text", "url": "url", "files": [{"name": "files", "accept": ["image/*", "video/*", "audio/*", "application/pdf", "text/*", "*/*"]}]}
  },
  "shortcuts": [
    {"name": "New conversation", "short_name": "New", "url": "./#comms/~new", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]},
    {"name": "Conversations", "short_name": "Chats", "url": "./#comms/~list", "icons": [{"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"}]}
  ],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
