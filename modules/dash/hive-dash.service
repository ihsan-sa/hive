[Unit]
Description=Hive web app (module dash, loopback only)

[Service]
# The app runs claude (sign-in, login checks): the manager's default PATH has no ~/.local/bin, where it installs.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -I %h/modules/dash/dash.py serve
Restart=on-failure
MemoryMax=300M
# Never in the way of the hive: last in line for CPU and disk, and a hard ceiling.
CPUQuota=100%
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=default.target
