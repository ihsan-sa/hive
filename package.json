{
  "name": "hive-app",
  "productName": "Hive",
  "version": "0.1.1",
  "description": "The Hive as a desktop app: installs it on first launch, then shows the web app in its own window.",
  "homepage": "https://hivelab.ca",
  "author": {
    "name": "Hive",
    "email": "support@hivelab.ca"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/logic.test.js && node test/page.test.js",
    "dist": "electron-builder --linux --win --mac --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.62.1"
  },
  "build": {
    "appId": "cc.ihsan.hive",
    "productName": "Hive",
    "files": [
      "main.js",
      "lib.js",
      "preload.js",
      "setup.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "Hive-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "hive-app"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "Hive-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "curl",
        "git",
        "python3"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "alsa-lib",
        "mesa-libgbm",
        "curl",
        "git",
        "python3"
      ],
      "fpm": [
        "--directories",
        "/opt/Hive"
      ]
    }
  },
  "desktopName": "hive-app.desktop"
}
